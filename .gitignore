# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example committed
!.env.example

# Service-account keys and anything else credential-shaped.
#
# `.env*` above already covers the env file, but a Google service-account key is
# a JSON file with a private key inside it — a different shape, and one that a
# `git add .` would happily stage. Ignored by directory AND by name, so moving
# the file does not quietly un-protect it.
secrets/
*service-account*.json
*credentials*.json

# Pre-drop records of real staff data, kept locally and never published.
#
# `archive/` holds what a destructive migration was about to remove — the
# instructor-to-category assignments taken before `InstructorCategory` was
# dropped, for example. They are real named people with employee codes, and
# this repository is public. The record is worth keeping and is worth keeping
# off GitHub, which is what this line is for.
archive/
