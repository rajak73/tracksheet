DATABASE_URL="postgresql://tracksheet:tracksheet@localhost:5433/tracksheet?schema=public"
SESSION_COOKIE_NAME="tracksheet_session"
SESSION_TTL_HOURS="12"

# Optional. Enables the AI summary card on the admin, manager and instructor
# dashboards. Leave it unset and every other feature works unchanged — the card
# reports that insights are not configured rather than inventing text.
# Server-side only: never prefix it with NEXT_PUBLIC_.
# A REAL key was committed here once and GitHub's push protection caught it.
# This file is the one .env that IS tracked — see the `!.env.example` exception
# in .gitignore — so anything written here is published. It is a template:
# placeholders only, never a value that works.
GEMINI_API_KEY="your-gemini-api-key"
