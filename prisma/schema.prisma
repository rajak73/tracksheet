// Phase 1 schema — identity, tenancy, and university configuration only.
// No activity/schedule/deliverable models yet (Phases 2-4).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and is supplied
// to PrismaClient at runtime via the pg adapter in src/server/db.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  INSTRUCTOR
}

enum ActivityStatus {
  COMPLETED
  MISSED
  LATE
  EXCUSED
}

/// The sole identity + auth record (Phase 0 §3.1).
/// `universityId` is the AUTHORITATIVE tenant binding used by the auth layer.
/// It is null for ADMIN and only for ADMIN — enforced by a CHECK constraint
/// added in migration `phase1_invariants`.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean @default(true)

  phone       String?
  lastLoginAt DateTime?
  /// Soft delete: an instructor leaving must not erase their recorded work.
  deletedAt   DateTime?

  universityId String?
  university   University? @relation("UniversityUsers", fields: [universityId], references: [id], onDelete: Restrict)

  managerProfile    Manager?
  instructorProfile Instructor?
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  reportJobs ReportJob[]

  /// Records this user authored on someone else's behalf (§14 created_by).
  activityLogsCreated ActivityLog[] @relation("ActivityCreatedBy")
  deliverablesCreated Deliverable[] @relation("DeliverableCreatedBy")

  // Target of the composite FKs on Manager/Instructor. This is what makes it
  // structurally impossible for a profile to sit in a different university
  // than its own user account.
  @@unique([id, universityId])
  @@index([universityId])
}

model University {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Human-facing tenant code (e.g. UNIV001). Unique platform-wide because it
  /// is used in exports and support conversations.
  code         String           @unique
  status       UniversityStatus @default(ACTIVE)
  country      String?
  state        String?
  city         String?
  contactEmail String?
  contactPhone String?

  /// Soft delete (§36): universities own historical workforce records, so a
  /// hard delete would destroy audit history. Nothing cascades from here.
  deletedAt DateTime?
  /// IANA timezone (e.g. "Asia/Kolkata"). Every "working day" boundary for this
  /// tenant is computed in this zone, never the server's or browser's (§3.3).
  timezone  String

  /// Configurable per university, defaults per the core business rule.
  openingDurationMin Int @default(15)
  closingDurationMin Int @default(15)

  /// Non-working break time inside the working day (e.g. lunch). Subtracted
  /// from available capacity, per the utilisation formula. Defaults to 0 so no
  /// break is ever assumed silently — each university configures its own.
  breakDurationMin Int @default(0)

  /// v1: one primary manager per university (§3.7). Nullable so a university can
  /// exist before its manager is provisioned; modelled as an FK rather than a
  /// flag on Manager so multi-manager support later needs no column split.
  primaryManagerId String?  @unique
  primaryManager   Manager? @relation("PrimaryManager", fields: [primaryManagerId], references: [id], onDelete: SetNull)

  users         User[]                   @relation("UniversityUsers")
  managers      Manager[]                @relation("UniversityManagers")
  instructors   Instructor[]             @relation("UniversityInstructors")
  workingHours  UniversityWorkingHours[]
  holidays      UniversityHoliday[]
  leaveRequests LeaveRequest[]
  activityLogs  ActivityLog[]
  deliverables  Deliverable[]
  aiInsights    AiInsight[]
  auditLogs     AuditLog[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  notifications           Notification[]
  universitySettings      UniversitySettings?
  departments             Department[]
  programs                Program[]
  academicTerms           AcademicTerm[]
  courses                 Course[]
  courseAssignments       CourseAssignment[]
  schedules               Schedule[]
  scheduleSlots           ScheduleSlot[]
  breakPolicies           BreakPolicy[]
  workloadTargets         WorkloadTarget[]
  reportingPeriods        ReportingPeriod[]
  instructorDailyMetrics  InstructorDailyMetric[]
  instructorWeeklyMetrics InstructorWeeklyMetric[]
  universityDailyMetrics  UniversityDailyMetric[]
  reportJobs              ReportJob[]
  deliverableLogs         DeliverableLog[]
}

/// One row per weekday per university. Times are minutes-from-midnight in the
/// university's own timezone — storing a TIME or DateTime here would silently
/// re-introduce a server-timezone dependency.
model UniversityWorkingHours {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday
  dayOfWeek    Int
  isWorkingDay Boolean @default(true)
  startMinute  Int
  endMinute    Int

  @@unique([universityId, dayOfWeek])
}

model UniversityHoliday {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// A calendar date in the university's timezone — deliberately DATE, not
  /// timestamptz, because a holiday is a local-calendar concept.
  date DateTime @db.Date
  name String

  @@unique([universityId, date])
}

model Manager {
  id           String @id @default(cuid())
  userId       String @unique
  universityId String

  // Composite FK: (userId, universityId) must match an existing (User.id,
  // User.universityId) pair. Guarantees profile.universityId can never drift
  // from the authoritative user.universityId.
  user       User       @relation(fields: [userId, universityId], references: [id, universityId], onDelete: Cascade)
  university University @relation("UniversityManagers", fields: [universityId], references: [id], onDelete: Restrict)

  primaryOf University? @relation("PrimaryManager")

  employeeCode String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  aiInsights   AiInsight[]

  // Required by Prisma for the composite FK above; userId alone is already
  // unique, so this adds no new business constraint.
  @@unique([userId, universityId])
  @@unique([universityId, employeeCode])
  @@index([universityId])
}

model Instructor {
  id           String @id @default(cuid())
  userId       String @unique
  universityId String

  user       User       @relation(fields: [userId, universityId], references: [id, universityId], onDelete: Cascade)
  university University @relation("UniversityInstructors", fields: [universityId], references: [id], onDelete: Restrict)

  employeeCode            String?
  activityLogs            ActivityLog[]
  deliverables            Deliverable[]
  leaveRequests           LeaveRequest[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  aiInsights              AiInsight[]
  courseAssignments       CourseAssignment[]
  schedules               Schedule[]
  scheduleSlots           ScheduleSlot[]
  workloadTargets         WorkloadTarget[]
  deliverableLogs         DeliverableLog[]
  instructorDailyMetrics  InstructorDailyMetric[]
  instructorWeeklyMetrics InstructorWeeklyMetric[]

  @@unique([userId, universityId])
  @@unique([universityId, employeeCode])
  @@index([universityId])
}

/// Activity taxonomy, held as DATA rather than a Prisma enum so a new type can
/// be added by an admin without a migration or redeploy.
///
/// Business logic must branch on the BEHAVIOURAL FLAGS below, never on `code`.
/// Keying off `code === "DAILY_OPENING"` would re-create the hard-coded enum
/// this table exists to avoid, and a custom type added later would silently get
/// none of the right treatment.
model ActivityType {
  id    String @id @default(cuid())
  /// Stable machine identifier, e.g. DAILY_OPENING. Unique across the platform.
  code  String @unique
  label String

  description String?
  sortOrder   Int     @default(100)
  isActive    Boolean @default(true)

  /// Seeded types are structural; deleting one would break historical records.
  isSystem Boolean @default(false)

  // ---- Behavioural flags ----

  /// At most one record per instructor per working day. True for DAILY_OPENING
  /// and DAILY_CLOSING only. Phase 3 enforces this with a unique index on
  /// (instructorId, workDate, activityTypeId) for types carrying this flag.
  isOncePerDay Boolean @default(false)

  /// Derived from the university's working-hours window rather than logged by
  /// an instructor against a class. True for DAILY_OPENING / DAILY_CLOSING —
  /// this is what stops them being generated per class.
  isDerivedFromWorkingHours Boolean @default(false)

  /// Counts toward productive/recognised time in the Phase 4 utilisation
  /// numerator. False for UNUTILIZED.
  countsAsProductive Boolean @default(true)

  /// Represents known idle time. Distinct from MISSING_DATA, which is the
  /// ABSENCE of any record and is therefore never a row in this table
  /// (Phase 0 §3.5).
  isUnutilized Boolean @default(false)

  activityLogs ActivityLog[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  scheduleSlots   ScheduleSlot[]
  workloadTargets WorkloadTarget[]

  @@index([isActive, sortOrder])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Approved leave REMOVES a day from available capacity, so an instructor is
/// never penalised in the utilisation percentage for a day they were not
/// expected to work. This is distinct from ABSENCE (unapproved, capacity
/// unchanged, a compliance signal) — see Phase 0 §3.6.
model LeaveRequest {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  /// Inclusive calendar range in the university's own timezone.
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  status    LeaveStatus @default(PENDING)
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId, startDate, endDate])
  @@index([universityId])
}

/// Server-side sessions (Phase 0 §2): revocable, and role/universityId are
/// re-read from the User row on every request rather than trusted from a token.
/// Only the SHA-256 of the token is stored, so a DB leak does not yield live
/// session credentials.
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  workDate  DateTime @db.Date
  startTime DateTime
  endTime   DateTime

  status  ActivityStatus @default(COMPLETED)
  remarks String?

  /// How the record came to exist (§15) — tells instructor-entered time apart
  /// from schedule-derived or imported time when auditing.
  source ActivitySource @default(INSTRUCTOR)

  /// Optional links to the planned slot and the deliverable this work served.
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  scheduleSlotId String?
  deliverable    Deliverable?  @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  deliverableId  String?

  /// Who wrote the record. Distinct from instructorId, which is its subject —
  /// a manager may log on an instructor's behalf.
  createdBy   User?   @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  isOncePerDay Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index set driven by the three measured dashboard queries (§33):
  //   instructor dashboard -> (instructorId, workDate)
  //   manager dashboard    -> (universityId, workDate)
  //   manager drill-down   -> (universityId, instructorId, workDate)
  // The bare (universityId) index is dropped: it is a prefix of the composite
  // below, so it added write cost without serving any query.
  @@index([instructorId, workDate])
  @@index([universityId, workDate])
  @@index([universityId, instructorId, workDate])
  @@index([scheduleSlotId])
  @@index([deliverableId])
}

model Deliverable {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  title          String
  description    String?
  category       String?
  targetQuantity Int
  targetHours    Float
  dueDate        DateTime @db.Date

  status DeliverableStatus @default(NOT_STARTED)

  createdBy   User?   @relation("DeliverableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  logs         DeliverableLog[]
  activityLogs ActivityLog[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([universityId, status])
  @@index([instructorId, status])
  @@index([universityId, dueDate])
}

model DeliverableLog {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  /// Carries its own tenant path rather than reaching it through Deliverable:
  /// a tenant-scoped query must not require a join to be safe, and this is the
  /// index the table is actually read by (§65).
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  workDate          DateTime @db.Date
  quantityCompleted Int
  hoursSpent        Float
  remarks           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliverableId, workDate])
  @@index([universityId, instructorId, workDate])
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InsightStatus {
  NEW
  READ
  DISMISSED
}

/// Structured insight record (§27). Deliberately NOT free text: every insight
/// carries the period it covers and the metric snapshot it was derived from, so
/// the UI can show the supporting numbers behind any claim (§59).
model AiInsight {
  id String @id @default(cuid())

  /// Scope determines which of the subject columns is populated. PLATFORM-scoped
  /// insights have no university, which is why universityId is nullable.
  scope        InsightScope @default(UNIVERSITY)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId String?
  instructor   Instructor?  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  managerId    String?
  manager      Manager?     @relation(fields: [managerId], references: [id], onDelete: Cascade)

  type           String
  severity       InsightSeverity
  title          String
  summary        String
  /// Retained for backwards compatibility with the existing rule set.
  recommendation String

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  /// Human-readable period label, e.g. "2026-09-07 to 2026-09-11".
  period      String

  /// The exact metric snapshot the text was derived from.
  sourceMetrics  Json
  supportingData Json

  status    InsightStatus @default(NEW)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, createdAt])
  @@index([instructorId, createdAt])
  @@index([scope, status])
}

model AuditLog {
  id String @id @default(cuid())

  /// Nullable so a global ADMIN action is still recorded. Previously this was
  /// required, so every admin action hit a `return` in the logger and was
  /// silently dropped — the audit trail was blind to exactly the most
  /// privileged actor.
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  action     String
  /// Entity type + id the action targeted, for drill-down from the log.
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([universityId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  type    String    @default("GENERAL")
  title   String
  message String
  isRead  Boolean   @default(false)
  /// Nullable timestamp rather than only a boolean, so "when was this read" is
  /// answerable and the unread index stays selective.
  readAt  DateTime?

  createdAt DateTime @default(now())

  // §40: the unread-first query is (userId, readAt, createdAt).
  @@index([userId, readAt, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS (added with the domain expansion)
// ═══════════════════════════════════════════════════════════════════════════

enum UniversityStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// How an activity record came to exist (§15).
enum ActivitySource {
  SYSTEM
  SCHEDULE
  INSTRUCTOR
  MANAGER
  IMPORT
  API
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum InsightScope {
  PLATFORM
  UNIVERSITY
  MANAGER
  INSTRUCTOR
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  BEREAVEMENT
  OTHER
}

enum HolidayType {
  PUBLIC
  UNIVERSITY
  OPTIONAL
}

enum TermStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ScheduleSlotStatus {
  PLANNED
  CONFIRMED
  CANCELLED
}

enum ReportingPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ReportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// ═══════════════════════════════════════════════════════════════════════════
// TENANCY — configuration split out of the University row (§9)
// ═══════════════════════════════════════════════════════════════════════════

/// One row per university. Kept separate from `University` so operational
/// configuration can grow without widening the tenant identity row that is
/// read on nearly every request.
model UniversitySettings {
  id           String     @id @default(cuid())
  universityId String     @unique
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// Free-form policy blobs. Deliberately Json: these are read whole by the
  /// calculation service and never filtered on, so columns would add migration
  /// churn for no query benefit.
  utilizationConfig     Json?
  activityLoggingPolicy Json?
  defaultBreakPolicy    Json?

  /// Retention window for raw activity records, in days. Null = keep forever.
  activityRetentionDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// ACADEMIC STRUCTURE (§18, §19)
// ═══════════════════════════════════════════════════════════════════════════

model Department {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name String
  code String

  programs  Program[]
  courses   Course[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Tenant-scoped uniqueness (§34): two universities may both have "CS".
  @@unique([universityId, code])
  @@index([universityId])
}

model Program {
  id           String      @id @default(cuid())
  universityId String
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  name String
  code String

  courses   Course[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([universityId, code])
  @@index([universityId])
}

model AcademicTerm {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  status    TermStatus @default(PLANNED)

  assignments CourseAssignment[]
  schedules   Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
  @@index([universityId, startDate, endDate])
}

model Course {
  id           String      @id @default(cuid())
  universityId String
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programId    String?
  program      Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  code    String
  title   String
  credits Int?

  assignments   CourseAssignment[]
  scheduleSlots ScheduleSlot[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([universityId, code])
  @@index([universityId])
}

/// An instructor teaches a course for a term. Modelled as its own table rather
/// than a column on the instructor so teaching history is preserved when
/// assignments change (§19).
model CourseAssignment {
  id             String        @id @default(cuid())
  universityId   String
  university     University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId   String
  instructor     Instructor    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  role      String?
  startDate DateTime?        @db.Date
  endDate   DateTime?        @db.Date
  status    AssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, instructorId, academicTermId])
  @@index([universityId, instructorId])
  @@index([universityId, courseId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SCHEDULING (§17, §24)
// ═══════════════════════════════════════════════════════════════════════════

model Schedule {
  id             String        @id @default(cuid())
  universityId   String
  university     University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId   String
  instructor     Instructor    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  name      String?
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  slots     ScheduleSlot[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([universityId, instructorId])
}

/// One planned block of an instructor's day. Relational rather than a JSON
/// document so slots can be indexed, validated, and compared against what was
/// actually logged (§17).
model ScheduleSlot {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  scheduleId   String?
  schedule     Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)

  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  /// Local calendar date in the university's timezone, matching ActivityLog.
  workDate  DateTime           @db.Date
  startTime DateTime
  endTime   DateTime
  location  String?
  status    ScheduleSlotStatus @default(PLANNED)

  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, workDate])
  @@index([instructorId, workDate])
  @@index([universityId, instructorId, workDate])
}

/// Recurring non-working break inside the working day. Per-university and
/// per-weekday, because break schedules are not uniform across tenants (§24).
model BreakPolicy {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name        String
  /// Null = applies to every working day.
  dayOfWeek   Int?
  startMinute Int
  endMinute   Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKLOAD TARGETS & REPORTING PERIODS (§21, §22)
// ═══════════════════════════════════════════════════════════════════════════

/// Per-university expectation for how much time an activity type should take.
/// Effective-dated so changing a target does not rewrite history.
model WorkloadTarget {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// Null instructorId = the university-wide default for this activity type.
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  activityTypeId String?
  activityType   ActivityType? @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)

  targetMinutes Int
  periodType    ReportingPeriodType @default(WEEKLY)
  effectiveFrom DateTime            @db.Date
  effectiveTo   DateTime?           @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, activityTypeId, effectiveFrom])
  @@index([instructorId, effectiveFrom])
}

model ReportingPeriod {
  id           String      @id @default(cuid())
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  type      ReportingPeriodType
  name      String
  startDate DateTime            @db.Date
  endDate   DateTime            @db.Date

  createdAt DateTime @default(now())

  @@unique([universityId, type, startDate, endDate])
  @@index([universityId, startDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// ANALYTICS SUMMARY TABLES (§29, §30)
// ═══════════════════════════════════════════════════════════════════════════
//
// These exist because the admin dashboard query measured as a Parallel Seq Scan
// over ActivityLog (399 ms at 100 universities / 3.9M rows). No index fixes a
// full-platform aggregate — the fix is to aggregate once per day in a job and
// have dashboards read the rollup. Raw ActivityLog remains the source of truth
// and is used for drill-down (§60).
//
// Minutes, not hours: integers avoid float drift when summing millions of rows.

model InstructorDailyMetric {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  metricDate DateTime @db.Date

  capacityMinutes    Int @default(0)
  productiveMinutes  Int @default(0)
  unutilizedMinutes  Int @default(0)
  /// Capacity on an expected working day with no records at all. Never folded
  /// into unutilized — "we don't know" is not "they did nothing" (§23).
  missingDataMinutes Int @default(0)
  overlapMinutes     Int @default(0)

  /// Per-activity-type breakdown, keyed by activity type code.
  minutesByActivityType Json @default("{}")

  isWorkingDay     Boolean @default(true)
  nonWorkingReason String?
  openingLogged    Boolean @default(false)
  closingLogged    Boolean @default(false)

  utilizationPercent Float?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// One row per instructor per day; the job upserts on this key.
  @@unique([instructorId, metricDate])
  @@index([universityId, metricDate])
  @@index([universityId, instructorId, metricDate])
}

model InstructorWeeklyMetric {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  capacityMinutes    Int @default(0)
  productiveMinutes  Int @default(0)
  unutilizedMinutes  Int @default(0)
  missingDataMinutes Int @default(0)

  minutesByActivityType Json   @default("{}")
  utilizationPercent    Float?
  openingCompliancePct  Float?
  closingCompliancePct  Float?
  expectedWorkingDays   Int    @default(0)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instructorId, periodStart])
  @@index([universityId, periodStart])
}

/// What the admin dashboard reads instead of scanning ActivityLog.
model UniversityDailyMetric {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  metricDate DateTime @db.Date

  activeInstructors  Int @default(0)
  capacityMinutes    Int @default(0)
  productiveMinutes  Int @default(0)
  unutilizedMinutes  Int @default(0)
  missingDataMinutes Int @default(0)

  minutesByActivityType Json   @default("{}")
  utilizationPercent    Float?
  openingCompliancePct  Float?
  closingCompliancePct  Float?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([universityId, metricDate])
  @@index([metricDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// REPORTING JOBS (§41)
// ═══════════════════════════════════════════════════════════════════════════

/// Large exports are queued, not generated inside the request. The row is the
/// handover point between the API and a background worker.
model ReportJob {
  id           String      @id @default(cuid())
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  reportType String
  format     String          @default("CSV")
  parameters Json            @default("{}")
  status     ReportJobStatus @default(QUEUED)

  /// Object-storage key once generated; never the file contents.
  resultUrl    String?
  errorMessage String?
  rowCount     Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([universityId, createdAt])
  @@index([status, createdAt])
}

enum MetricsJobTrigger {
  SCHEDULED
  MANUAL
  SEED
}

enum MetricsJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Execution record for the metric rollup.
///
/// Exists so "are the dashboards current?" is answerable without guessing. It
/// deliberately is NOT an AuditLog row: AuditLog.userId is non-null because
/// every entry there is an act by a person, and a scheduled job has no actor.
model MetricsJobRun {
  id      String            @id @default(cuid())
  trigger MetricsJobTrigger
  status  MetricsJobStatus  @default(RUNNING)

  /// Window recomputed, as YYYY-MM-DD.
  fromDate String
  toDate   String

  universitiesProcessed  Int @default(0)
  instructorDaysWritten  Int @default(0)
  instructorWeeksWritten Int @default(0)

  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationMs   Int?

  @@index([status, startedAt])
  @@index([startedAt])
}
