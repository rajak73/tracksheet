// ═══════════════════════════════════════════════════════════════════════════
// TENANCY — configuration split out of the University row (§9)
// ═══════════════════════════════════════════════════════════════════════════

/// One row per university. Kept separate from `University` so operational
/// configuration can grow without widening the tenant identity row that is
/// read on nearly every request.
model UniversitySettings {
  id           String     @id @default(cuid())
  universityId String     @unique
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// Free-form policy blobs. Deliberately Json: these are read whole by the
  /// calculation service and never filtered on, so columns would add migration
  /// churn for no query benefit.
  utilizationConfig     Json?
  activityLoggingPolicy Json?
  defaultBreakPolicy    Json?

  /// Retention window for raw activity records, in days. Null = keep forever.
  activityRetentionDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// ACADEMIC STRUCTURE (§18, §19)
// ═══════════════════════════════════════════════════════════════════════════

model Department {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name String
  code String

  programs  Program[]
  courses   Course[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Tenant-scoped uniqueness (§34): two universities may both have "CS".
  @@unique([universityId, code])
  @@index([universityId])
}

model Program {
  id           String      @id @default(cuid())
  universityId String
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  name String
  code String

  courses   Course[]
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([universityId, code])
  @@index([universityId])
}

model AcademicTerm {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime   @db.Date
  endDate   DateTime   @db.Date
  status    TermStatus @default(PLANNED)

  assignments CourseAssignment[]
  schedules   Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
  @@index([universityId, startDate, endDate])
}

model Course {
  id           String      @id @default(cuid())
  universityId String
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programId    String?
  program      Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)

  code    String
  title   String
  credits Int?

  assignments   CourseAssignment[]
  scheduleSlots ScheduleSlot[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([universityId, code])
  @@index([universityId])
}

/// An instructor teaches a course for a term. Modelled as its own table rather
/// than a column on the instructor so teaching history is preserved when
/// assignments change (§19).
model CourseAssignment {
  id             String        @id @default(cuid())
  universityId   String
  university     University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId   String
  instructor     Instructor    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  role      String?
  startDate DateTime?        @db.Date
  endDate   DateTime?        @db.Date
  status    AssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, instructorId, academicTermId])
  @@index([universityId, instructorId])
  @@index([universityId, courseId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SCHEDULING (§17, §24)
// ═══════════════════════════════════════════════════════════════════════════

model Schedule {
  id             String        @id @default(cuid())
  universityId   String
  university     University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId   String
  instructor     Instructor    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  academicTermId String?
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: SetNull)

  name      String?
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  slots     ScheduleSlot[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([universityId, instructorId])
}

/// One planned block of an instructor's day. Relational rather than a JSON
/// document so slots can be indexed, validated, and compared against what was
/// actually logged (§17).
model ScheduleSlot {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  scheduleId   String?
  schedule     Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)

  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  /// Local calendar date in the university's timezone, matching ActivityLog.
  workDate  DateTime           @db.Date
  startTime DateTime
  endTime   DateTime
  location  String?
  status    ScheduleSlotStatus @default(PLANNED)

  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, workDate])
  @@index([instructorId, workDate])
  @@index([universityId, instructorId, workDate])
}

/// Recurring non-working break inside the working day. Per-university and
/// per-weekday, because break schedules are not uniform across tenants (§24).
model BreakPolicy {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  name        String
  /// Null = applies to every working day.
  dayOfWeek   Int?
  startMinute Int
  endMinute   Int
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKLOAD TARGETS & REPORTING PERIODS (§21, §22)
// ═══════════════════════════════════════════════════════════════════════════

/// Per-university expectation for how much time an activity type should take.
/// Effective-dated so changing a target does not rewrite history.
model WorkloadTarget {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// Null instructorId = the university-wide default for this activity type.
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  activityTypeId String?
  activityType   ActivityType? @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)

  targetMinutes Int
  periodType    ReportingPeriodType @default(WEEKLY)
  effectiveFrom DateTime            @db.Date
  effectiveTo   DateTime?           @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, activityTypeId, effectiveFrom])
  @@index([instructorId, effectiveFrom])
}

model ReportingPeriod {
  id           String      @id @default(cuid())
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  type      ReportingPeriodType
  name      String
  startDate DateTime            @db.Date
  endDate   DateTime            @db.Date

  createdAt DateTime @default(now())

  @@unique([universityId, type, startDate, endDate])
  @@index([universityId, startDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// ANALYTICS SUMMARY TABLES (§29, §30)
// ═══════════════════════════════════════════════════════════════════════════
//
// These exist because the admin dashboard query measured as a Parallel Seq Scan
// over ActivityLog (399 ms at 100 universities / 3.9M rows). No index fixes a
// full-platform aggregate — the fix is to aggregate once per day in a job and
// have dashboards read the rollup. Raw ActivityLog remains the source of truth
// and is used for drill-down (§60).
//
// Minutes, not hours: integers avoid float drift when summing millions of rows.

model InstructorDailyMetric {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  metricDate DateTime @db.Date

  capacityMinutes    Int @default(0)
  productiveMinutes  Int @default(0)
  unutilizedMinutes  Int @default(0)
  /// Capacity on an expected working day with no records at all. Never folded
  /// into unutilized — "we don't know" is not "they did nothing" (§23).
  missingDataMinutes Int @default(0)
  overlapMinutes     Int @default(0)

  /// Per-activity-type breakdown, keyed by activity type code.
  minutesByActivityType Json @default("{}")

  isWorkingDay     Boolean @default(true)
  nonWorkingReason String?
  openingLogged    Boolean @default(false)
  closingLogged    Boolean @default(false)

  utilizationPercent Float?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// One row per instructor per day; the job upserts on this key.
  @@unique([instructorId, metricDate])
  @@index([universityId, metricDate])
  @@index([universityId, instructorId, metricDate])
}

model InstructorWeeklyMetric {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  capacityMinutes    Int @default(0)
  productiveMinutes  Int @default(0)
  unutilizedMinutes  Int @default(0)
  missingDataMinutes Int @default(0)

  minutesByActivityType Json   @default("{}")
  utilizationPercent    Float?
  openingCompliancePct  Float?
  closingCompliancePct  Float?
  expectedWorkingDays   Int    @default(0)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instructorId, periodStart])
  @@index([universityId, periodStart])
}

/// What the admin dashboard reads instead of scanning ActivityLog.
model UniversityDailyMetric {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  metricDate DateTime @db.Date

  activeInstructors  Int @default(0)
  capacityMinutes    Int @default(0)
  productiveMinutes  Int @default(0)
  unutilizedMinutes  Int @default(0)
  missingDataMinutes Int @default(0)

  minutesByActivityType Json   @default("{}")
  utilizationPercent    Float?
  openingCompliancePct  Float?
  closingCompliancePct  Float?

  /// The counts those percentages are made of.
  ///
  /// Stored because a period's compliance is not the average of its days'
  /// compliance. The live engine computes openings over expected instructor-
  /// days — a ratio of sums — while the dashboard averaged the stored daily
  /// percentages, and an unweighted mean of ratios disagrees with a ratio of
  /// sums the moment the denominators differ. Approved leave and part-week
  /// holidays make them differ constantly.
  ///
  /// The rollup already had these in hand and threw them away.
  openingsLogged         Int @default(0)
  closingsLogged         Int @default(0)
  /// Instructor-days expected on this date: the denominator of both figures.
  expectedInstructorDays Int @default(0)

  /// The two numbers the Active-Instructor Average Hours feature divides.
  ///
  /// "Active" = this instructor's `productiveMinutes` that day was > 0. An
  /// instructor with no submission and one whose entries summed to exactly
  /// 0m are the same case here — both are absent from both fields below,
  /// never present as a zero. See `src/domain/average-hours.ts` for the
  /// confirmed formula these feed: sum every day's minutes, sum every day's
  /// count, divide once — never an average of daily averages.
  activeInstructorMinutes Int @default(0)
  activeInstructorCount   Int @default(0)

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([universityId, metricDate])
  @@index([metricDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// REPORTING JOBS (§41)
// ═══════════════════════════════════════════════════════════════════════════

/// Large exports are queued, not generated inside the request. The row is the
/// handover point between the API and a background worker.
model ReportJob {
  id           String      @id @default(cuid())
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  reportType String
  format     String          @default("CSV")
  parameters Json            @default("{}")
  status     ReportJobStatus @default(QUEUED)

  /// Object-storage key once generated; never the file contents.
  resultUrl    String?
  errorMessage String?
  rowCount     Int?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([universityId, createdAt])
  @@index([status, createdAt])
}

enum MetricsJobTrigger {
  SCHEDULED
  MANUAL
  SEED
}

enum MetricsJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// Execution record for the metric rollup.
///
/// Exists so "are the dashboards current?" is answerable without guessing. It
/// deliberately is NOT an AuditLog row: AuditLog.userId is non-null because
/// every entry there is an act by a person, and a scheduled job has no actor.
model MetricsJobRun {
  id      String            @id @default(cuid())
  trigger MetricsJobTrigger
  status  MetricsJobStatus  @default(RUNNING)

  /// Window recomputed, as YYYY-MM-DD.
  fromDate String
  toDate   String

  universitiesProcessed  Int @default(0)
  instructorDaysWritten  Int @default(0)
  instructorWeeksWritten Int @default(0)

  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationMs   Int?

  @@index([status, startedAt])
  @@index([startedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// BULK IMPORT — onboarding an existing organisation from a file
// ═══════════════════════════════════════════════════════════════════════════

enum ImportSourceType {
  CSV
  PDF
}

enum ImportStatus {
  /// Parsed, awaiting column mapping.
  UPLOADED
  /// Mapping decided, awaiting validation.
  MAPPED
  /// Validated; the preview is ready and the admin has not confirmed yet.
  VALIDATED
  /// Confirmed and being written, in batches.
  PROCESSING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
}

/// One bulk import, from upload to written rows.
///
/// ── Why this table exists at all ───────────────────────────────────────────
/// A row here is not architecture for its own sake; four requirements make it
/// unavoidable, and each one is a requirement the feature cannot drop:
///
///   1. The workflow is four steps (upload -> map -> validate -> confirm) and
///      the dataset has to survive between them. The alternative is making the
///      browser re-upload a 10,000-row file at every step.
///   2. Writing 10,000 rows cannot finish inside one HTTP request, so the
///      request must hand off and the client must be able to ask "how far".
///   3. "Who imported what, and what did it do" has to be answerable later.
///   4. Re-running an interrupted import must not duplicate anything, which
///      needs the parsed rows and the progress counter to be durable.
///
/// ── Why not an AuditLog row ────────────────────────────────────────────────
/// The same reason `MetricsJobRun` is not one: `AuditLog.userId` is NOT NULL,
/// and progress is written repeatedly by background work with no actor at the
/// keyboard. The audit trail still records the import as an event — this table
/// records its execution. Neither replaces the other.
///
/// ── What is deliberately NOT stored ────────────────────────────────────────
/// Not the uploaded file, and no credential. `rows` holds the PARSED,
/// structurally-typed records only, which is what steps 2-4 operate on; the
/// original bytes are dropped once parsed. The batch password supplied at
/// confirmation is hashed and used, never written here.
model ImportJob {
  id String @id @default(cuid())

  /// Restrict, not Cascade: import history outlives the admin who ran it.
  /// (`ReportJob` uses Cascade and loses its history with the user; that is the
  /// wrong trade for a record of what entered the database.)
  createdById String
  createdBy   User   @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  sourceType ImportSourceType
  fileName   String
  fileSize   Int
  /// SHA-256 of the uploaded bytes. Not a uniqueness constraint: re-importing a
  /// corrected file is legitimate, and the upsert is idempotent regardless. It
  /// is here so the UI can warn "this exact file was already imported".
  checksum   String

  status ImportStatus @default(UPLOADED)

  /// Source column header -> canonical field name, as confirmed by the admin.
  mapping Json @default("{}")
  /// The parsed records. Structurally typed, never the raw file.
  rows    Json @default("[]")

  rowCount      Int @default(0)
  processedRows Int @default(0)

  /// Bounded diagnostics — the first N of each, never the whole dataset.
  errors   Json @default("[]")
  warnings Json @default("[]")
  /// Preview counts before confirmation, outcome counts after.
  summary  Json @default("{}")

  /// Populated only for PDF, where extraction is interpretive.
  extractionConfidence String?
  errorMessage         String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@index([checksum])
}


// ═══════════════════════════════════════════════════════════════════════════
// FREE-TEXT WORKLOG — what the instructor wrote, and what was parsed from it
// ═══════════════════════════════════════════════════════════════════════════

/// One deliverable within a broad category — "Lecture" inside Teaching.
///
/// ── Why this is a table and not a string on ActivityLog ────────────────────
/// It is a CLOSED vocabulary the client supplied, and closed vocabularies stop
/// being closed the moment they are free text: "Lecture", "lecture" and "Lec"
/// become three deliverables and the sheet's quantity column stops adding up.
/// A foreign key makes the AI's output checkable — a deliverable that is not in
/// this table simply cannot be written.
///
/// ── Not the same thing as `Deliverable` ────────────────────────────────────
/// `Deliverable` is a piece of work ASSIGNED to one instructor, with a target
/// and a due date. This is the taxonomy those pieces of work are classified by.
/// They are different nouns that unfortunately share a word.
model DeliverableType {
  id    String @id @default(cuid())
  /// Stable machine name, e.g. `LECTURE`. What the parser is allowed to emit.
  code  String @unique
  label String

  /// The broad category this belongs under.
  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  /// Whether a COUNT of this means anything.
  ///
  /// The client's monthly sheet lists every kind of work with its hours, but
  /// counts only some of them: "12 Classes, 6 Assignments, 3 Doubt Sessions"
  /// beside a deliverable list that also held Lesson Prep and Meetings/Reports.
  /// That is not an omission — "6 lesson preps" is not a sentence anybody says.
  /// Preparation, meetings, reporting and admin are EFFORT: their hours are
  /// real and are reported, but they have no unit to be counted in.
  ///
  /// Defaulted true because most are countable, and because a wrong default
  /// that shows a number is easier to notice than one that hides it.
  isCountable Boolean @default(true)

  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityTypeId, sortOrder])
}

/// Whether a submission may be recorded, or needs a manager's agreement first.
enum WorklogApproval {
  /// Written on the day, inside the university's hours, describing work inside
  /// them. The ordinary case, and it needs nobody's permission.
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

/// Why a submission needed asking about. Both can apply at once.
enum WorklogExceptionReason {
  /// Submitted outside the university's working hours.
  SUBMITTED_OFF_HOURS
  /// One or more activities fall outside the working-hours window.
  ACTIVITY_OFF_HOURS
  /// Both of the above.
  BOTH
}

enum WorklogParseStatus {
  /// Saved, not yet parsed. The instructor's text is already safe at this point.
  PENDING
  /// A read is running right now.
  ///
  /// Distinct from PENDING because they answer different questions and the
  /// screen says different things: PENDING is "queued", PROCESSING is
  /// "analysing your worklog". It also survives a restart, which the in-process
  /// in-flight set cannot — a submission left PROCESSING by a killed process is
  /// visibly stuck rather than invisibly abandoned.
  PROCESSING
  /// Read, and the activities written. The completed state.
  PARSED
  /// The provider could not be reached, or returned nothing usable. The raw text
  /// is intact and the submission can be parsed again.
  FAILED
}

/// How the instructor typed the day, which decides how it is read.
enum WorklogInputMode {
  /// One line per activity, already separated by the person who wrote it.
  BULLETS
  /// A paragraph in their own words, from which the activities are found.
  NARRATIVE
}

/// One press of Submit: the bullets exactly as typed, and the clock they start.
///
/// ── Why this exists rather than living on ActivityLog ──────────────────────
/// Three requirements need a row that is neither an activity nor an instructor:
///
///   1. The text must survive a parsing failure. Saving the submission FIRST and
///      parsing afterwards is what makes "the instructor's data is never lost"
///      true rather than aspirational.
///   2. The review clock is PER SUBMISSION — two submissions on two days each
///      run their own — so it needs somewhere to live that is not the instructor
///      and not any one activity.
///   3. A bullet can fail to parse while its siblings succeed. This row holds
///      every bullet; `ActivityLog` holds only the ones that became work.
model WorklogSubmission {
  id String @id @default(cuid())

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  /// The day being logged, in the university's zone.
  workDate DateTime @db.Date

  /// The bullets, in order, exactly as typed. Never rewritten by parsing.
  rawBullets Json

  /// Which reader this submission needs. Persisted rather than inferred: the
  /// read happens in the background, after the request that knew is gone, and a
  /// paragraph read as bullets is one activity instead of five.
  inputMode WorklogInputMode @default(BULLETS)

  status     WorklogParseStatus @default(PENDING)
  /// Why parsing failed, in words an instructor can act on. Never a stack trace.
  parseError String?

  /// The bullets that produced no activity, each with the reason, in bullet
  /// order: `[{ index, rawText, reason }]`.
  ///
  /// Without this the review view can only tell an instructor that a line is
  /// missing, which is the least useful half of the answer — "no time could be
  /// read from this line" and "this overlaps 14:00–15:00" ask for completely
  /// different corrections. The reason is produced while writing and is not
  /// recoverable afterwards, so it is kept rather than recomputed.
  ///
  /// Rewritten in full on every parse, so a re-parse that succeeds clears what
  /// the failed one recorded.
  rejections Json?

  /// t0. The review clock runs from here and from nothing else — how fast
  /// parsing happened must not move anybody's deadline.
  submittedAt DateTime  @default(now())
  parsedAt    DateTime?

  /// Replaced by a later submission for the same day.
  ///
  /// ── Why the old one is kept at all ────────────────────────────────────
  /// Editing a day means "this is what happened, not what I said before", so
  /// the ACTIVITIES from the earlier text are removed — they no longer describe
  /// anything. The submission itself stays, marked here, because it is the
  /// record of what the instructor actually wrote at the time, and deleting
  /// somebody's own words to make a screen tidier is not a trade this product
  /// makes. Reads filter it out; the audit trail can still find it.
  supersededAt DateTime?

  /// When the instructor first corrected a parsed entry from this submission.
  /// Its presence at the three-hour mark is the whole escalation decision.
  reviewedAt DateTime?

  /// When the manager was told. Set once and never cleared: a later correction
  /// adds `reviewedAt` beside it rather than erasing the fact that it was
  /// escalated, because "flagged and then fixed" and "never flagged" are
  /// different histories and a manager is entitled to tell them apart.
  escalatedAt DateTime?

  /// The read succeeded, but something about it wants the instructor's eye.
  ///
  /// Distinct from `rejections`, which says a line produced nothing at all, and
  /// from `parseError`, which says the read failed. This is the middle state the
  /// client asked for: the day was organised, and an activity has no times, or
  /// two of them overlap, or the paragraph mentions a clock time that did not
  /// end up against anything. Nothing is wrong with the record — it is complete
  /// and correct as far as it goes — and a person is the only one who can say
  /// whether it goes far enough.
  needsReview Boolean   @default(false)

  /// Why, in words the instructor can act on: `[{ kind, message }]`. Rewritten
  /// in full on every parse, so a re-read that comes back clean clears them.
  reviewNotes Json?

  /* ── Approval ─────────────────────────────────────────────────────────────
   * An instructor records their OWN day, inside their university's hours, and
   * that needs no permission — the overwhelming case is `NOT_REQUIRED` and it
   * costs a manager nothing.
   *
   * What is asked about is work that falls outside those hours, or a day
   * written up after them. Both are legitimate — people stay late — but both
   * are also how a timesheet quietly stops reflecting the working day it is
   * measured against, so a person rather than a rule decides.
   *
   * The submission itself carries this rather than a separate request table:
   * what a manager needs in order to decide IS the submission — the sentences,
   * the times, and what they were read as. A request row pointing at it would
   * be the same thing with an extra join.
   */
  approval        WorklogApproval         @default(NOT_REQUIRED)
  exceptionReason WorklogExceptionReason?
  decidedById     String?
  decidedBy       User?                   @relation("WorklogDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  /// The manager's own words, shown to the instructor. Never a code.
  decisionNote    String?

  activities ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The escalation sweep reads exactly this shape: not yet escalated, not yet
  // reviewed, old enough to be due.
  @@index([escalatedAt, reviewedAt, submittedAt])
  // The manager's queue: everything waiting on them, oldest first.
  @@index([approval, universityId, submittedAt])
  @@index([instructorId, workDate])
  // Reads want the day's LIVE submissions, never the replaced ones.
  @@index([instructorId, workDate, supersededAt])
  @@index([status, submittedAt])
}


/// One day's worklog, normalised for reading.
///
/// ── Why this is a cache and never a source ────────────────────────────────
/// The instructor's own words stay in `ActivityLog.rawText`, untouched. This
/// holds what a model made of them: better names for the activities, a label
/// for what each one is counted in, and tidied remarks.
///
/// It holds NO numbers taken from the model. `groups` records which source rows
/// each named group covers, and every duration and quantity on screen is summed
/// from those rows at read time. A model that miscounts therefore cannot put a
/// wrong figure in front of anybody — it has no figures to give.
///
/// `sourceFingerprint` is taken over the activities it was built from. Correct
/// one of them and the fingerprint stops matching, so the row is stale and is
/// rebuilt rather than shown against data it no longer describes.
model WorklogDaySummary {
  id String @id @default(cuid())

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// The day, in the university's zone.
  workDate DateTime @db.Date

  /// Over the source activities. A mismatch means rebuild.
  sourceFingerprint String

  /// `[{ name, quantityLabel, sourceIds }]`. Names and labels only — no figures.
  groups Json

  /// Normalised remarks, as a list of strings.
  remarks Json

  /// The deterministic total at the time it was written, for a cheap check.
  totalMinutes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instructorId, workDate])
  @@index([universityId, workDate])
}

/// One cached AI insight per (instructor, scope, period).
///
/// The insight is generated at most once per distinct state of the underlying
/// work logs. `contextHash` is what decides that: it is SHA-256 over the
/// canonical context, the prompt version and the model id, so a data edit, a
/// prompt edit and a model switch all invalidate by the same comparison.
///
/// Invalidation is content-based ONLY. There is no TTL and no scheduled
/// regeneration — an insight that still matches its data is still correct
/// however old it is, and one that does not is wrong however fresh.
///
/// Nothing cascades. Changing a day changes the DAY hash, and also the WEEK and
/// MONTH hashes, because those contexts contain that day's rows. That falls out
/// of hashing and needs no code.
model AiInsightCache {
  id String @id @default(cuid())

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  scopeType   InsightScopeType
  periodStart DateTime         @db.Date
  periodEnd   DateTime         @db.Date

  /// SHA-256 hex of canonical JSON + prompt version + model id.
  contextHash String @db.Char(64)

  /// The frozen combined context of every day in the period.
  ///
  /// Looks redundant against `WorklogEntry` and is not. That table is LIVE — the
  /// instructor can edit any day at any moment. This is what the insight was
  /// actually built from, frozen at generation.
  ///
  /// Comparing the two is how staleness is detected, and it is the only way to
  /// answer "what was this insight based on?" — the question asked the first
  /// time an insight looks wrong in front of a client. Never write it without
  /// writing `insightPayload`, `contextHash` and `generatedAt` in the same
  /// transaction: the four are one fact and disagree only if something is broken.
  rawContext Json

  /// The model's reply, stored as returned.
  insightPayload Json

  promptVersion String
  modelId       String

  status InsightCacheStatus @default(READY)

  generatedAt  DateTime  @default(now())
  lastServedAt DateTime?
  /// Incremented on every cache hit. This is how the saving is measured.
  serveCount   Int       @default(0)

  /// CONSECUTIVE failures; reset to zero by any success. At three the view
  /// stops trying on its own and offers a manual retry instead, so a broken
  /// provider cannot be re-billed once per page load.
  failureCount Int     @default(0)
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per scope: the cache is keyed by what it describes, not by when it
  /// was written, so a regeneration replaces rather than accumulates.
  @@unique([instructorId, scopeType, periodStart, periodEnd])
  @@index([contextHash])
}

enum InsightScopeType {
  DAY
  WEEK
  MONTH
}

enum InsightCacheStatus {
  READY
  GENERATING
  FAILED
}

/// One row per instructor per day. The only source of truth.
///
/// ── The shape is the form ─────────────────────────────────────────────────
/// Four fields, and they are exactly the four boxes an instructor fills in: what
/// they did, how much of it, how long the day was, and a note. Nothing here is
/// derived and nothing is parsed on the way in.
///
/// An earlier shape held a JSON array of activities, parsed out of the text at
/// write time. That put a parser between somebody and their own words, and made
/// the stored row a claim about what they meant rather than a record of what
/// they wrote. The structure is now derived AFTER the fact, into
/// `DayExtraction`, where it can be wrong without damaging the record.
model WorklogEntry {
  id String @id @default(cuid())

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  /// Carried on the row rather than reached through the instructor: every read
  /// is tenant-scoped, and a join for the boundary check is a join that can be
  /// forgotten.
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  /// The day the work was done, in the university's zone.
  logDate DateTime @db.Date

  /// What they did, in their own words. Typically names how many and how long.
  deliverable String

  /// A corroborating note — "5 class", "2 batches", "half day", or nothing.
  /// Free text, stored and shown verbatim, never coerced to a number.
  deliverableQuantity String?

  /// The day's total, entered SEPARATELY by the instructor.
  ///
  /// That separateness is what makes it useful: it is independent of whatever
  /// the text says, so extracted hours can be reconciled against it. Hours the
  /// text attributes to nothing are the difference, and that difference is a
  /// fact worth showing rather than an error to hide.
  workingHours Decimal @default(0) @db.Decimal(6, 2)

  remarks String?

  status WorklogEntryStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per instructor per day, enforced by the database rather than by a
  /// writer remembering to check.
  @@unique([instructorId, logDate])
  /// A manager's period view reads by date across instructors.
  @@index([logDate])
  @@index([universityId, logDate])
}

/// What the model made of one day's text, parsed once and reused.
///
/// ── Why a table and not a step ────────────────────────────────────────────
/// Extraction is per DAY, and a week contains seven of them. Without this,
/// opening a week re-parses seven days that were already parsed when the
/// instructor opened each of them, and opening the month re-parses thirty.
///
/// `sourceHash` is the day's own canonical context. Because a day's context is a
/// subset of its week's and its month's, one edit moves all three hashes and
/// invalidates all three — no cascade code, which is the point.
model DayExtraction {
  id String @id @default(cuid())

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  logDate DateTime @db.Date

  /// SHA-256 over this day's canonical context, prompt version and model id.
  sourceHash String @db.Char(64)

  /// The exact canonical JSON that was parsed. Frozen; see `AiInsightCache`.
  rawContext Json

  /// `[{ label, sessions, hours }]`. `sessions` and `hours` are null wherever
  /// the text did not state them — null is the correct answer to silence, and a
  /// guess never is.
  items Json @default("[]")

  /// The day's hours the text attributed to no activity.
  ///
  /// `workingHours` minus the extracted hours. Commonly the whole day, when
  /// somebody wrote what they did without saying how long each part took. Shown
  /// rather than hidden: without it the group hours look as though they should
  /// add up to the total, and somebody eventually tries to reconcile them.
  unallocatedHours Decimal @default(0) @db.Decimal(6, 2)

  status DayExtractionStatus @default(READY)

  promptVersion String
  modelId       String

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([instructorId, logDate])
}

enum DayExtractionStatus {
  READY
  FAILED
}

enum WorklogEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// The categories and deliverables that were dropped, keyed by the row they came
/// from.
///
/// A recovery path and nothing else. Application code must never read this — if
/// something needs one of these values, the removal was incomplete and the fix is
/// upstream, not a join to here.
model WorklogActivityArchive {
  id String @id @default(cuid())

  /// The `ActivityLog.id` this came from. Not a foreign key: the row it names is
  /// dropped, and an archive that cascades with its source is not an archive.
  activityLogId String @unique

  instructorId String
  workDate     DateTime @db.Date

  activityTypeCode  String?
  activityTypeLabel String?
  deliverableCode   String?
  deliverableLabel  String?
  broadCategoryCode String?
  broadCategoryLabel String?
  quantity          Int?

  archivedAt DateTime @default(now())

  @@index([instructorId, workDate])
}
