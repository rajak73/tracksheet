// Phase 1 schema — identity, tenancy, and university configuration only.
// No activity/schedule/deliverable models yet (Phases 2-4).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (CLI) and is supplied
// to PrismaClient at runtime via the pg adapter in src/server/db.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  INSTRUCTOR
}

enum ActivityStatus {
  COMPLETED
  MISSED
  LATE
  EXCUSED
}

/// The sole identity + auth record (Phase 0 §3.1).
/// `universityId` is the AUTHORITATIVE tenant binding used by the auth layer.
/// It is null for ADMIN and only for ADMIN — enforced by a CHECK constraint
/// added in migration `phase1_invariants`.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean @default(true)

  phone       String?
  /// The user's own profile picture, held as a size-capped `data:` URI.
  ///
  /// A column rather than a file because this application has no object storage
  /// and deliberately writes no uploads to disk — the bulk importer drops the
  /// files it reads for the same reason. An avatar is small and is read only by
  /// the profile endpoints, never by session validation, so the cost stays where
  /// it belongs. The endpoint enforces the image type and the size cap; nothing
  /// else in the application writes this field.
  avatarUrl   String?
  lastLoginAt DateTime?

  /// When this person left. Soft delete: someone leaving must not erase their
  /// recorded work. Set together with `isActive: false`, cleared if they are
  /// ever reinstated.
  ///
  /// `isActive` alone answered "can they sign in", which is the security
  /// question, and left the OPERATIONAL one — who left, and when — recoverable
  /// only by reading the audit log. A company keeps a leavers list; this is the
  /// column that makes one queryable.
  deletedAt   DateTime?

  /// Why they left, in the operator's own words. Never a credential, and never
  /// a judgement the system invented — it is typed by whoever processes the exit.
  leftReason  String?

  universityId String?
  university   University? @relation("UniversityUsers", fields: [universityId], references: [id], onDelete: Restrict)

  managerProfile    Manager?
  instructorProfile Instructor?
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  reportJobs ReportJob[]
  importJobs ImportJob[] @relation("ImportJobCreatedBy")
  worklogDecisions WorklogSubmission[] @relation("WorklogDecidedBy")

  /// Records this user authored on someone else's behalf (§14 created_by).
  activityLogsCreated ActivityLog[] @relation("ActivityCreatedBy")
  deliverablesCreated Deliverable[] @relation("DeliverableCreatedBy")

  // Target of the composite FKs on Manager/Instructor. This is what makes it
  // structurally impossible for a profile to sit in a different university
  // than its own user account.
  @@unique([id, universityId])
  @@index([universityId])
  /// The leavers list is a filter on this, so it should not be a table scan.
  @@index([deletedAt])
}

model University {
  id   String @id @default(cuid())
  name String
  slug String @unique

  /// Human-facing tenant code (e.g. UNIV001). Unique platform-wide because it
  /// is used in exports and support conversations.
  code         String           @unique
  status       UniversityStatus @default(ACTIVE)
  country      String?
  state        String?
  city         String?
  contactEmail String?
  contactPhone String?

  /// Soft delete (§36): universities own historical workforce records, so a
  /// hard delete would destroy audit history. Nothing cascades from here.
  deletedAt DateTime?
  /// IANA timezone (e.g. "Asia/Kolkata"). Every "working day" boundary for this
  /// tenant is computed in this zone, never the server's or browser's (§3.3).
  timezone  String

  /// Configurable per university, defaults per the core business rule.
  openingDurationMin Int @default(15)
  closingDurationMin Int @default(15)

  /// Non-working break time inside the working day (e.g. lunch). Subtracted
  /// from available capacity, per the utilisation formula. Defaults to 0 so no
  /// break is ever assumed silently — each university configures its own.
  breakDurationMin Int @default(0)

  /// v1: one primary manager per university (§3.7). Nullable so a university can
  /// exist before its manager is provisioned; modelled as an FK rather than a
  /// flag on Manager so multi-manager support later needs no column split.
  primaryManagerId String?  @unique
  primaryManager   Manager? @relation("PrimaryManager", fields: [primaryManagerId], references: [id], onDelete: SetNull)

  users         User[]                   @relation("UniversityUsers")
  managers      Manager[]                @relation("UniversityManagers")
  instructors   Instructor[]             @relation("UniversityInstructors")
  workingHours  UniversityWorkingHours[]
  holidays      UniversityHoliday[]
  leaveRequests LeaveRequest[]
  activityLogs  ActivityLog[]
  deliverables  Deliverable[]
  aiInsights    AiInsight[]
  auditLogs     AuditLog[]
  worklogSubmissions WorklogSubmission[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  notifications           Notification[]
  universitySettings      UniversitySettings?
  departments             Department[]
  programs                Program[]
  academicTerms           AcademicTerm[]
  courses                 Course[]
  courseAssignments       CourseAssignment[]
  schedules               Schedule[]
  scheduleSlots           ScheduleSlot[]
  breakPolicies           BreakPolicy[]
  workloadTargets         WorkloadTarget[]
  reportingPeriods        ReportingPeriod[]
  instructorDailyMetrics  InstructorDailyMetric[]
  instructorWeeklyMetrics InstructorWeeklyMetric[]
  universityDailyMetrics  UniversityDailyMetric[]
  reportJobs              ReportJob[]
  deliverableLogs         DeliverableLog[]

  worklogDaySummaries WorklogDaySummary[]

  /// One row per day. See `WorklogEntry`.
  worklogEntries WorklogEntry[]
}

/// One row per weekday per university. Times are minutes-from-midnight in the
/// university's own timezone — storing a TIME or DateTime here would silently
/// re-introduce a server-timezone dependency.
model UniversityWorkingHours {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday
  dayOfWeek    Int
  isWorkingDay Boolean @default(true)
  startMinute  Int
  endMinute    Int

  @@unique([universityId, dayOfWeek])
}

model UniversityHoliday {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  /// A calendar date in the university's timezone — deliberately DATE, not
  /// timestamptz, because a holiday is a local-calendar concept.
  date DateTime @db.Date
  name String

  @@unique([universityId, date])
}

model Manager {
  id           String @id @default(cuid())
  userId       String @unique
  universityId String

  // Composite FK: (userId, universityId) must match an existing (User.id,
  // User.universityId) pair. Guarantees profile.universityId can never drift
  // from the authoritative user.universityId.
  user       User       @relation(fields: [userId, universityId], references: [id, universityId], onDelete: Cascade)
  university University @relation("UniversityManagers", fields: [universityId], references: [id], onDelete: Restrict)

  primaryOf University? @relation("PrimaryManager")

  employeeCode String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  aiInsights   AiInsight[]

  /// The instructors this manager leads. A manager owns a roster, not the whole
  /// university: two managers in one tenant have different people reporting to
  /// them, which is the distinction the university-level scope cannot express.
  instructors Instructor[] @relation("ManagerInstructors")

  // Required by Prisma for the composite FK above; userId alone is already
  // unique, so this adds no new business constraint.
  @@unique([userId, universityId])
  @@unique([universityId, employeeCode])
  // Target for Instructor's composite (managerId, universityId) FK. `id` is
  // already the primary key, so this adds no business constraint either — it
  // exists so the database can enforce that a manager and the instructors
  // reporting to them are always in the same university.
  @@unique([id, universityId])
  @@index([universityId])
}

/// The instructor's own note about a day: "all planned sessions completed",
/// "lab ran short, two students to follow up".
///
/// ── Why this is not the activity remarks joined together ──────────────────
/// Those are read out of the sentences and describe individual entries — a
/// topic, a batch, a unit. This is a judgement about the DAY as a whole, and
/// only the person who lived it can make it. The client's report has a column
/// for exactly this, and filling it by concatenating topics would put "binary
/// trees, section A" where "all planned sessions completed" belongs.
///
/// One per instructor per day, so writing it again is a correction rather than
/// a second opinion.
model WorklogDayNote {
  id String @id @default(cuid())

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  universityId String
  /// The day being described, in the university's zone.
  workDate DateTime @db.Date

  note String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instructorId, workDate])
  @@index([universityId, workDate])
}

/// What an instructor TEACHES: Technical, English, Aptitude or Mathematics.
///
/// ── It is a specialism, not a department ──────────────────────────────────
/// Somebody from any tech discipline delivering programming is TECH; the column
/// says what they teach, not which department they came from. Confirmed against
/// the client's own roster: TECH instructors sit against Programming
/// Foundations, Python, Node JS, DSA and React; ENGLISH against Communicative
/// English Foundation and Advanced; APTITUDE against Logical Reasoning and
/// Quantitative Aptitude; MATH against Numerical Ability and Probability &
/// Statistics. Four categories, ~600 instructors, and the split is clean.
///
/// ── Why it cannot be derived, and must be set ─────────────────────────────
/// The obvious shortcut is to read somebody's courses and infer their stream.
/// The data says no: below the top few courses the associations overlap heavily
/// — ENGLISH instructors are attached to "Build Your Own Static Website",
/// MATH instructors to "Generative AI" — because an instructor is linked to the
/// whole programme their students take, not only what they personally deliver.
/// Any inference from activity would therefore be wrong for a large minority,
/// and wrong differently each month: somebody who spent a month on meetings
/// would change category, and a signed-off sheet would reshuffle its own rows
/// between two readings of the same period. Somebody is hired into a stream and
/// stays in it, so an admin sets it and it stays set.
///
/// Held as a TABLE rather than an enum for the same reason the activity
/// taxonomy is: adding "Data Science" should be an insert and a seed run, not
/// a migration and a deploy.
model InstructorCategory {
  id    String @id @default(cuid())
  code  String @unique
  label String

  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  instructors  Instructor[]
  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Instructor {
  id           String @id @default(cuid())
  userId       String @unique
  universityId String

  /// Nullable because it is ASSIGNED, never inferred — an instructor nobody has
  /// categorised yet is a real state, and the sheet shows it as blank rather
  /// than guessing. `Restrict`, so a category in use cannot be deleted out from
  /// under the rows that report on it.
  categoryId String?
  category   InstructorCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  user       User       @relation(fields: [userId, universityId], references: [id, universityId], onDelete: Cascade)
  university University @relation("UniversityInstructors", fields: [universityId], references: [id], onDelete: Restrict)

  /// Who this instructor reports to. Nullable because ownership is assigned by
  /// an admin, never inferred: an instructor who has not been placed on a
  /// roster yet is "unassigned", which is a real state and not a defect.
  ///
  /// The FK is COMPOSITE — (managerId, universityId) against Manager's
  /// (id, universityId) — so PostgreSQL itself refuses an instructor whose
  /// manager belongs to another university. That is the same technique the
  /// User relation above uses, and it means cross-tenant assignment is
  /// impossible rather than merely guarded against in application code.
  ///
  /// Restrict, not SetNull: on a composite FK, SET NULL would null BOTH
  /// columns, and universityId is NOT NULL. Managers are deactivated rather
  /// than deleted, so nothing legitimate is blocked.
  managerId String?
  manager   Manager? @relation("ManagerInstructors", fields: [managerId, universityId], references: [id, universityId], onDelete: Restrict)

  employeeCode            String?
  activityLogs            ActivityLog[]
  deliverables            Deliverable[]
  leaveRequests           LeaveRequest[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  aiInsights              AiInsight[]
  courseAssignments       CourseAssignment[]
  schedules               Schedule[]
  scheduleSlots           ScheduleSlot[]
  workloadTargets         WorkloadTarget[]
  deliverableLogs         DeliverableLog[]
  instructorDailyMetrics  InstructorDailyMetric[]
  instructorWeeklyMetrics InstructorWeeklyMetric[]
  worklogDayNotes         WorklogDayNote[]

  @@unique([userId, universityId])
  @@unique([universityId, employeeCode])
  // The paginated GET /api/instructors route always orders by createdAt.
  // (universityId, createdAt) replaces the bare (universityId) index below —
  // universityId alone is a prefix of this composite, so the single-column
  // index served no query the composite doesn't also serve, and dropping it
  // avoids paying its write cost twice. (createdAt) is separate because it
  // serves the ADMIN case with no universityId filter (a full-platform list);
  // a composite index can't satisfy an ORDER BY on its second column without
  // an equality condition on the first. Measured on a 20,514-row table:
  // filtered case 6.6ms -> 0.07ms, unfiltered case 7.4ms -> 0.06ms (both via
  // Sort-over-Seq-Scan -> Index Scan).
  @@index([universityId, createdAt])
  @@index([createdAt])
  // Every manager-scoped report filters on this column.
  @@index([managerId])

  worklogSubmissions WorklogSubmission[]

  worklogDaySummaries WorklogDaySummary[]

  /// Cached AI insights for this instructor's periods. See `AiInsightCache`.
  insightCaches AiInsightCache[]

  /// One row per day. See `WorklogEntry`.
  worklogEntries WorklogEntry[]

  /// Parsed structure per day. See `DayExtraction`.
  dayExtractions DayExtraction[]
}

/// Activity taxonomy, held as DATA rather than a Prisma enum so a new type can
/// be added by an admin without a migration or redeploy.
///
/// Business logic must branch on the BEHAVIOURAL FLAGS below, never on `code`.
/// Keying off `code === "DAILY_OPENING"` would re-create the hard-coded enum
/// this table exists to avoid, and a custom type added later would silently get
/// none of the right treatment.
model ActivityType {
  id    String @id @default(cuid())
  /// Stable machine identifier, e.g. DAILY_OPENING. Unique across the platform.
  code  String @unique
  label String

  description String?
  sortOrder   Int     @default(100)
  isActive    Boolean @default(true)

  /// Seeded types are structural; deleting one would break historical records.
  isSystem Boolean @default(false)

  // ---- Behavioural flags ----

  /// At most one record per instructor per working day. True for DAILY_OPENING
  /// and DAILY_CLOSING only. Phase 3 enforces this with a unique index on
  /// (instructorId, workDate, activityTypeId) for types carrying this flag.
  isOncePerDay Boolean @default(false)

  /// Derived from the university's working-hours window rather than logged by
  /// an instructor against a class. True for DAILY_OPENING / DAILY_CLOSING —
  /// this is what stops them being generated per class.
  isDerivedFromWorkingHours Boolean @default(false)

  /// Counts toward productive/recognised time in the Phase 4 utilisation
  /// numerator. False for UNUTILIZED.
  countsAsProductive Boolean @default(true)

  /// Represents known idle time. Distinct from MISSING_DATA, which is the
  /// ABSENCE of any record and is therefore never a row in this table
  /// (Phase 0 §3.5).
  isUnutilized Boolean @default(false)

  activityLogs ActivityLog[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  scheduleSlots   ScheduleSlot[]
  workloadTargets WorkloadTarget[]

  @@index([isActive, sortOrder])

  deliverableTypes DeliverableType[]
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Approved leave REMOVES a day from available capacity, so an instructor is
/// never penalised in the utilisation percentage for a day they were not
/// expected to work. This is distinct from ABSENCE (unapproved, capacity
/// unchanged, a compliance signal) — see Phase 0 §3.6.
model LeaveRequest {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  /// Inclusive calendar range in the university's own timezone.
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  status    LeaveStatus @default(PENDING)
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId, startDate, endDate])
  @@index([universityId])
  /// The analytics engine, exception detector, notification sweep and every
  /// report run this exact predicate on every request:
  ///   universityId = ? AND status = 'APPROVED' AND startDate <= ? AND endDate >= ?
  /// `@@index([universityId])` alone leaves the status and period filters to a
  /// row filter, which grows with a tenant's whole leave history.
  @@index([universityId, status, startDate, endDate])
}

/// Server-side sessions (Phase 0 §2): revocable, and role/universityId are
/// re-read from the User row on every request rather than trusted from a token.
/// Only the SHA-256 of the token is stored, so a DB leak does not yield live
/// session credentials.
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  activityTypeId String
  activityType   ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)

  workDate  DateTime @db.Date
  startTime DateTime
  endTime   DateTime

  /// Did the instructor actually GIVE this clock range, or did we place it?
  ///
  /// `startTime`/`endTime` are never null, because duration is derived from
  /// them and every reader needs a range to derive it from. But a range is not
  /// always something anybody said: the four-field form asks for hours and no
  /// clock at all, and `placeOnDay` lays those end to end from the start of the
  /// day. A narrative line can be either — "9 to 11 took a lecture" states one,
  /// "spent 2h on lab prep" does not.
  ///
  /// Without this, a screen showing "9 AM – 11 AM" was presenting our
  /// arithmetic as the instructor's testimony. Readers that have it show the
  /// range when it was stated and the duration when it was not.
  ///
  /// Defaults FALSE: for a row written before this column existed we genuinely
  /// do not know, and "we placed it" is the honest answer to that rather than a
  /// claim nobody made. The migration backfills the narrative rows, which are
  /// the ones most likely to have carried real times.
  timesStated Boolean @default(false)

  status  ActivityStatus @default(COMPLETED)
  remarks String?

  /// How the record came to exist (§15) — tells instructor-entered time apart
  /// from schedule-derived or imported time when auditing.
  source ActivitySource @default(INSTRUCTOR)

  /// Optional links to the planned slot and the deliverable this work served.
  scheduleSlot   ScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  scheduleSlotId String?
  deliverable    Deliverable?  @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  deliverableId  String?

  /// Who wrote the record. Distinct from instructorId, which is its subject —
  /// a manager may log on an instructor's behalf.
  createdBy   User?   @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  isOncePerDay Boolean @default(false)

  /// The bullet this row was parsed from, exactly as the instructor typed it.
  ///
  /// Kept forever, and deliberately on the ROW rather than only on the
  /// submission: somebody asking "did the AI read this right?" is looking at one
  /// activity, and the answer has to sit beside it. Null for rows created by any
  /// other path — a manager logging on somebody's behalf, or the importer.
  rawText String?

  /// The Deliverable Quantity box, exactly as typed — "2", "2 classes", "?".
  ///
  /// Beside `quantity`, not instead of it. `quantity` is the integer every
  /// total is summed from; this is what the person actually wrote, and the
  /// table prints it verbatim. They answer different questions: "how many"
  /// against "what did they say".
  ///
  /// It exists because the two are not recoverable from each other. "2
  /// classes" and "2" both parse to 2, and printing the parse back meant an
  /// instructor could not find their own words on the screen — the same
  /// failure `rawText` was added for.
  ///
  /// Null for rows created by any path that has no box: a manager logging on
  /// somebody's behalf, the importer, the seed.
  rawQuantity String?

  /// The Working Hours box, exactly as typed — "6h 00m", "6 hours 30 minutes".
  ///
  /// Beside `startTime`/`endTime`, which remain the authority for every
  /// computed duration. Same reasoning as `rawQuantity`: the clock positions
  /// are what the arithmetic uses, and this is what was written.
  rawWorkingHours String?

  /// Which press of Submit produced this row. Null for non-worklog entries.
  submissionId String?
  submission   WorklogSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  /// The specific deliverable the AI matched within the broad category, from the
  /// fixed taxonomy. Null when nothing in the taxonomy fits, which is a real
  /// answer rather than a failure.
  /// Which subject this entry falls under — Technical, English, Aptitude,
  /// Mathematics — as the reader judged it FROM THE SENTENCE.
  ///
  /// ── Why per entry, and not simply the instructor's own ────────────────
  /// An instructor is filed under one stream, and that is what the client's
  /// monthly sheet prints. But a day is not always one subject: the same
  /// person can take a DSA class and then a communication session, and a
  /// column that answered "Technical" for both would be describing the person
  /// where the row is asking about the work.
  ///
  /// Nullable, and left null rather than guessed: a line like "staff meeting
  /// 2 to 3" has no subject at all, and filling one in would be inventing the
  /// most consequential column in the report.
  broadCategoryId String?
  broadCategory   InstructorCategory? @relation(fields: [broadCategoryId], references: [id], onDelete: Restrict)

  deliverableTypeId String?
  deliverableType   DeliverableType? @relation(fields: [deliverableTypeId], references: [id], onDelete: SetNull)

  /// How many of that deliverable this row accounts for.
  ///
  /// ── NULL means the instructor never said ──────────────────────────────
  /// Not missing data to be tidied away with a default — it is the client's
  /// `?`. Their rule is explicit: "graded some assignments" with no number must
  /// never become "1 Assignment", because the whole point of that column is how
  /// many, and an invented one is indistinguishable from a real one once it is
  /// in the sheet.
  ///
  /// It is deliberately not zero either. Zero is a count; "none" and "unknown"
  /// are answers a manager acts on differently.
  ///
  /// A quantity of 1 is still written without anybody stating it, but only for
  /// deliverables whose unit counts OCCURRENCES — a class, a meeting, a
  /// workshop. There, the entry is one of them by definition. See `Counting` in
  /// `@/domain/worklog-taxonomy`.
  ///
  /// The default stays 1 so every path that does not know about this — the
  /// importer, a hand-written insert — keeps behaving as it did. Only the
  /// parsers write null, and only where the client's rule says they must.
  quantity Int? @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index set driven by the three measured dashboard queries (§33):
  //   instructor dashboard -> (instructorId, workDate)
  //   manager dashboard    -> (universityId, workDate)
  //   manager drill-down   -> (universityId, instructorId, workDate)
  // The bare (universityId) index is dropped: it is a prefix of the composite
  // below, so it added write cost without serving any query.
  //
  // (instructorId, startTime) added for the paginated GET .../activities
  // route: it filters by instructorId and orders by startTime, NOT workDate,
  // so the index above left Postgres sorting every matching row before
  // applying LIMIT. Measured on a 100k-row table, one instructor with 20k
  // activities: 12.8ms (Sort over all 20k rows) -> 0.07ms (Index Scan
  // stopping at LIMIT) for page one; page one is materially more common than
  // deep pagination, so that is where this matters.
  @@index([instructorId, startTime])
  @@index([instructorId, workDate])
  @@index([universityId, workDate])
  @@index([universityId, instructorId, workDate])
  @@index([scheduleSlotId])
  @@index([deliverableId])
  // The report groups by subject; without this that is a scan per week.
  @@index([broadCategoryId])
  // Superseding a day deletes by this. It had a foreign key and no index, so
  // that delete was a sequential scan — 1,057 ms measured on 3.9M rows, on the
  // path an instructor takes every time they correct their own day.
  @@index([submissionId])
}

model Deliverable {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)

  title          String
  description    String?
  category       String?
  targetQuantity Int
  targetHours    Float
  dueDate        DateTime @db.Date

  status DeliverableStatus @default(NOT_STARTED)

  createdBy   User?   @relation("DeliverableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  logs         DeliverableLog[]
  activityLogs ActivityLog[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([universityId, status])
  @@index([instructorId, status])
  @@index([universityId, dueDate])
}

model DeliverableLog {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  /// Carries its own tenant path rather than reaching it through Deliverable:
  /// a tenant-scoped query must not require a join to be safe, and this is the
  /// index the table is actually read by (§65).
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  workDate          DateTime @db.Date
  quantityCompleted Int
  hoursSpent        Float
  remarks           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliverableId, workDate])
  @@index([universityId, instructorId, workDate])
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InsightStatus {
  NEW
  READ
  DISMISSED
}

/// Structured insight record (§27). Deliberately NOT free text: every insight
/// carries the period it covers and the metric snapshot it was derived from, so
/// the UI can show the supporting numbers behind any claim (§59).
model AiInsight {
  id String @id @default(cuid())

  /// Scope determines which of the subject columns is populated. PLATFORM-scoped
  /// insights have no university, which is why universityId is nullable.
  scope        InsightScope @default(UNIVERSITY)
  universityId String?
  university   University?  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  instructorId String?
  instructor   Instructor?  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  managerId    String?
  manager      Manager?     @relation(fields: [managerId], references: [id], onDelete: Cascade)

  type           String
  severity       InsightSeverity
  title          String
  summary        String
  /// Retained for backwards compatibility with the existing rule set.
  recommendation String

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  /// Human-readable period label, e.g. "2026-09-07 to 2026-09-11".
  period      String

  /// The exact metric snapshot the text was derived from.
  sourceMetrics  Json
  supportingData Json

  status    InsightStatus @default(NEW)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId, createdAt])
  @@index([instructorId, createdAt])
  @@index([scope, status])
}

model AuditLog {
  id String @id @default(cuid())

  /// Nullable so a global ADMIN action is still recorded. Previously this was
  /// required, so every admin action hit a `return` in the logger and was
  /// silently dropped — the audit trail was blind to exactly the most
  /// privileged actor.
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  action     String
  /// Entity type + id the action targeted, for drill-down from the log.
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([universityId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  type    String    @default("GENERAL")
  title   String
  message String
  isRead  Boolean   @default(false)
  /// Nullable timestamp rather than only a boolean, so "when was this read" is
  /// answerable and the unread index stays selective.
  readAt  DateTime?

  /// Stable identity for a recurring condition, e.g. "DELIVERABLE_DUE:<id>".
  /// The rollup runs hourly, so without this the same unresolved condition
  /// would notify the same person every hour forever.
  dedupeKey String?

  createdAt DateTime @default(now())

  /// One live notification per user per condition.
  @@unique([userId, dedupeKey])
  // §40: the unread-first query is (userId, readAt, createdAt).
  @@index([userId, readAt, createdAt])
}

