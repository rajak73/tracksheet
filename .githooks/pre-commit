#!/bin/sh
#
# Runs before every commit. A failure here stops the commit.
#
# ── Why a subset and not all 973 tests ────────────────────────────────────
# The full suite takes five to eight minutes depending on machine load. A gate
# that costs that much on every commit is a gate people learn to pass with
# --no-verify, and a bypassed gate protects nothing. This runs the checks that
# catch the highest-consequence regressions in about thirty seconds:
#
#   tsc          the whole repository, in two seconds
#   eslint       the files being committed
#   test:gate    tenant isolation, roster isolation, the Gemini-call rule,
#                the taxonomy decisions, the report format, the shared row
#                builder — 130 tests
#
# The full suite is still the standard before deploying. See the README.
#
# ── What this checks is the WORKING TREE, not the index ───────────────────
# Stated plainly because it matters: if you stage some files and leave others
# modified, these run against everything on disk, not against what is about to
# be committed. Stashing the difference inside a hook is the usual fix and it
# is a well-known way to lose work, so it is not done here.

set -e

# Hooks run with a minimal PATH under some Git GUIs, where node is invisible.
PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"
export PATH

if ! command -v npx >/dev/null 2>&1; then
  echo "pre-commit: cannot find npx on PATH. Commit blocked rather than skipped."
  echo "            Run the commit from a shell where 'npx' works."
  exit 1
fi

# The tests need Postgres. Without it the failure is a wall of Prisma output
# that looks like broken code, so say what is actually wrong.
#
# The PORT is what gets checked, not `docker info`. The daemon being up says
# nothing about whether the containers are — and containers stopped while the
# daemon runs is the case that actually happens. Asking the daemon let exactly
# that through and produced the Prisma wall this guard exists to replace.
db_reachable() {
  # nc where there is one; /dev/tcp otherwise. If neither works, say nothing
  # and let the tests report their own failure — a check that cannot run must
  # not block every commit on this machine.
  if command -v nc >/dev/null 2>&1; then
    nc -z -w 2 127.0.0.1 5434 >/dev/null 2>&1
    return $?
  fi
  (exec 3<>/dev/tcp/127.0.0.1/5434) >/dev/null 2>&1 || return 1
  return 0
}

if command -v nc >/dev/null 2>&1 && ! db_reachable; then
  echo "pre-commit: the test database is not reachable on port 5434."
  if docker info >/dev/null 2>&1; then
    echo "            Docker is running but the containers are not. Try: npm run db:up"
  else
    echo "            Docker is not running. Start it, then: npm run db:up"
  fi
  exit 1
fi

echo "pre-commit: typechecking…"
npx tsc --noEmit

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '^src/generated/' || true)
if [ -n "$STAGED" ]; then
  echo "pre-commit: linting staged files…"
  # --max-warnings=0 is load-bearing, not pedantry.
  #
  # This project's unused-variable rule is a WARNING, and eslint exits 0 on
  # warnings — so without this the lint step ran, printed the problem, and let
  # the commit through anyway. Found by testing the hook rather than trusting
  # it: a deliberate unused constant was committed while the gate reported
  # "passed". Dead code is exactly what that rule is for.
  # shellcheck disable=SC2086
  npx eslint --max-warnings=0 $STAGED
fi

echo "pre-commit: running the gate suite…"
npm run --silent test:gate

echo "pre-commit: passed."
